    # ==================== بارگذاری و ذخیره ====================
    def _load_settings(self):
        if os.path.exists(CONFIG_FILE):
            try:
                with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                    return json.load(f)
            except:
                pass
        return {
            "theme": "dark",
            "notifications": True,
            "sound": True,
            "selenium_headless": False,
            "default_delay": 3,
            "timeout": 30
        }
    
    def _save_settings(self):
        with open(CONFIG_FILE, "w", encoding="utf-8") as f:
            json.dump(self.settings, f, ensure_ascii=False, indent=2)
    
    def _load_data(self):
        if os.path.exists("phones.json"):
            try:
                with open("phones.json", "r", encoding="utf-8") as f:
                    data = json.load(f)
                    self.phone_history = []
                    for item in data:
                        if isinstance(item, str):
                            self.phone_history.append({"phone": item, "first_name": "", "last_name": ""})
                        else:
                            self.phone_history.append(item)
            except:
                self.phone_history = []
        else:
            self.phone_history = []
        
        if os.path.exists("blacklist.json"):
            try:
                with open("blacklist.json", "r", encoding="utf-8") as f:
                    self.blacklist = json.load(f)
            except:
                self.blacklist = []
    
    def _load_history(self):
        if os.path.exists(HISTORY_FILE):
            try:
                with open(HISTORY_FILE, "r", encoding="utf-8") as f:
                    self.history = json.load(f)
            except:
                self.history = []
    
    def _save_history(self, entry):
        self.history.insert(0, entry)
        if len(self.history) > 100:
            self.history = self.history[:100]
        with open(HISTORY_FILE, "w", encoding="utf-8") as f:
            json.dump(self.history, f, ensure_ascii=False, indent=2)
        self._update_history_tab()
    
    def _save_data(self):
        with open("phones.json", "w", encoding="utf-8") as f:
            json.dump(self.phone_history, f, ensure_ascii=False, indent=2)
        with open("blacklist.json", "w", encoding="utf-8") as f:
            json.dump(self.blacklist, f, ensure_ascii=False, indent=2)
    
    # ==================== لاگ و آمار ====================
    def _log(self, msg, level="info"):
        ts = datetime.now().strftime("%H:%M:%S")
        icons = {"success": "✓", "error": "✗", "warning": "⚠", "info": "ℹ"}
        icon = icons.get(level, "ℹ")
        self.log_area.configure(state="normal")
        self.log_area.insert("end", f"[{ts}] {icon} {msg}\n", level)
        self.log_area.see("end")
        self.log_area.configure(state="disabled")
    
    def _update_stats_display(self):
        total = self.stats["success"] + self.stats["failed"]
        rate = (self.stats["success"] / total * 100) if total > 0 else 0
        
        if hasattr(self, 'success_card'):
            self.success_card.configure(text=f"{self.stats['success']}")
        if hasattr(self, 'failed_card'):
            self.failed_card.configure(text=f"{self.stats['failed']}")
        if hasattr(self, 'rate_card'):
            self.rate_card.configure(text=f"{rate:.1f}%")
        
        self.stats_label.configure(text=f"✓ Success: {self.stats['success']}  |  ✗ Failed: {self.stats['failed']}  |  📈 Rate: {rate:.1f}%")
        self.progress_bar.set(rate/100 if total > 0 else 0)
        self._update_chart()
    
    def _update_chart(self):
        if hasattr(self, 'chart_canvas'):
            self.chart_canvas.get_tk_widget().destroy()
        
        bg_color = '#1e1e2e' if self.settings.get("theme") == "dark" else '#f5f5f5'
        fig, ax = plt.subplots(figsize=(3, 2.5), facecolor=bg_color)
        total = self.stats["success"] + self.stats["failed"]
        
        if total > 0:
            sizes = [self.stats["success"], self.stats["failed"]]
            labels = ['Success', 'Failed']
            colors = ['#00C853', '#D32F2F']
            wedges, texts, autotexts = ax.pie(sizes, labels=labels, colors=colors, autopct='%1.1f%%', startangle=90,
                                                textprops={'fontsize': 9, 'color': 'white' if self.settings.get("theme") == "dark" else '#333'})
            for autotext in autotexts:
                autotext.set_color('white')
                autotext.set_fontsize(9)
            ax.axis('equal')
        else:
            ax.pie([1], colors=['#555555'], startangle=90)
            ax.text(0, 0, 'No Data', ha='center', va='center', fontsize=12, color='#888888', fontweight='bold')
            ax.axis('equal')
        
        fig.patch.set_alpha(0)
        self.chart_canvas = FigureCanvasTkAgg(fig, self.chart_frame)
        self.chart_canvas.draw()
        self.chart_canvas.get_tk_widget().pack(fill="both", expand=True)
    
    def _update_dashboard(self):
        self._update_stats_display()
    
    def _update_displays(self):
        self.phone_listbox.configure(state="normal")
        self.phone_listbox.delete(1.0, "end")
        for i, contact in enumerate(self.phone_history, 1):
            name = f"{contact.get('first_name', '')} {contact.get('last_name', '')}".strip()
            phone = contact.get('phone', '')
            if name:
                display_text = f"{i:2d}. {name:15} - {phone}\n"
            else:
                display_text = f"{i:2d}. {phone}\n"
            self.phone_listbox.insert("end", display_text)
        self.phone_listbox.configure(state="disabled")
        
        self.black_listbox.configure(state="normal")
        self.black_listbox.delete(1.0, "end")
        for i, phone in enumerate(self.blacklist, 1):
            self.black_listbox.insert("end", f"{i:2d}. {phone}\n")
        self.black_listbox.configure(state="disabled")
    
    def _update_history_tab(self):
        if hasattr(self, 'history_tree'):
            for item in self.history_tree.get_children():
                self.history_tree.delete(item)
            for entry in self.history[:50]:
                self.history_tree.insert("", "end", values=(
                    entry.get('time', ''),
                    entry.get('phone', ''),
                    entry.get('mode', ''),
                    f"{entry.get('success', 0)}/{entry.get('total', 0)}",
                    entry.get('result', '')
                ))
    
    # ==================== اعتبارسنجی اصلاح شده برای پشتیبانی از 099 و ترب ====================
    def _validate_phone(self):
        """اعتبارسنجی شماره تلفن با پشتیبانی از تمام پیشوندهای 091 تا 099"""
        phone = self.phone_entry.get().strip()
        
        # حذف کاراکترهای غیرعددی
        phone = re.sub(r'[^0-9]', '', phone)
        
        # اصلاح فرمت
        if phone.startswith('98'):
            phone = '0' + phone[2:]
        elif len(phone) == 10 and phone.startswith('9'):
            phone = '0' + phone
        elif len(phone) == 11 and phone.startswith('09'):
            pass  # فرمت درست
        
        # آپدیت فیلد
        self.phone_entry.delete(0, "end")
        self.phone_entry.insert(0, phone)
        
        # بررسی طول و پیشوند
        if len(phone) == 11 and phone.startswith('09'):
            # تشخیص اپراتور بر اساس 3 رقم اول بعد از 09
            prefix = phone[2:5]
            
            # لیست کامل پیشوندهای اپراتورها
            mci_prefixes = [
                '910', '911', '912', '913', '914', '915', '916', '917', '918', '919',
                '990', '991', '992', '993', '994', '995', '996', '997', '998', '999'
            ]
            irancell_prefixes = [
                '901', '902', '903', '904', '905',
                '930', '933', '935', '936', '937', '938', '939'
            ]
            rightel_prefixes = ['920', '921', '922']
            
            if prefix in mci_prefixes:
                operator = "MCI (Hamrah Aval)"
                self.phone_status.configure(text=f"✓ Valid | {operator} (0{prefix})", text_color="#4CAF50")
                return True
            elif prefix in irancell_prefixes:
                operator = "Irancell"
                self.phone_status.configure(text=f"✓ Valid | {operator} (0{prefix})", text_color="#4CAF50")
                return True
            elif prefix in rightel_prefixes:
                operator = "Rightel"
                self.phone_status.configure(text=f"✓ Valid | {operator} (0{prefix})", text_color="#4CAF50")
                return True
            else:
                self.phone_status.configure(text=f"⚠️ Accepting: 0{prefix} (Unknown operator)", text_color="#FF9800")
                return True  # قبول کن حتی اگه اپراتور ناشناس باشه
        else:
            self.phone_status.configure(text="✗ Invalid - Use 09XXXXXXXXX (11 digits)", text_color="#F44336")
            return False
    
    # ==================== مدیریت مخاطبین ====================
    def _on_contact_double_click(self, event):
        try:
            index = self.phone_listbox.index("@%d,%d" % (event.x, event.y))
            line = self.phone_listbox.get(f"{index} linestart", f"{index} lineend")
            if line.strip():
                if " - " in line:
                    phone = line.split(" - ")[1].strip()
                else:
                    parts = line.split(". ")
                    if len(parts) > 1:
                        phone = parts[1].strip()
                    else:
                        phone = line.strip()
                phone = phone.strip()
                self.phone_entry.delete(0, "end")
                self.phone_entry.insert(0, phone)
                self._validate_phone()
                self._log(f"Double-click selected: {phone}", "info")
        except Exception as e:
            pass
    
    def _open_save_contact_dialog(self):
        if not self._validate_phone():
            messagebox.showwarning("Warning", "Enter a valid phone number first")
            return
        phone = self.phone_entry.get().strip()
        for contact in self.phone_history:
            if contact.get('phone') == phone:
                messagebox.showwarning("Warning", "Phone number already exists!")
                return
        dialog = ctk.CTkToplevel(self)
        dialog.title("Save Contact")
        dialog.geometry("420x320")
        dialog.resizable(False, False)
        dialog.grab_set()
        x = self.winfo_x() + (self.winfo_width() - 420) // 2
        y = self.winfo_y() + (self.winfo_height() - 320) // 2
        dialog.geometry(f"+{x}+{y}")
        
        ctk.CTkLabel(dialog, text="Phone Number:", font=("Segoe UI", 13, "bold")).pack(pady=(20, 5))
        ctk.CTkLabel(dialog, text=phone, font=("Inter", 11)).pack()
        ctk.CTkLabel(dialog, text="First Name:", font=("Segoe UI", 13, "bold")).pack(pady=(15, 5))
        first_name_entry = ctk.CTkEntry(dialog, width=280, placeholder_text="e.g., Alex", font=("Inter", 11))
        first_name_entry.pack()
        ctk.CTkLabel(dialog, text="Last Name:", font=("Segoe UI", 13, "bold")).pack(pady=(10, 5))
        last_name_entry = ctk.CTkEntry(dialog, width=280, placeholder_text="e.g., Johnson", font=("Inter", 11))
        last_name_entry.pack()
        
        def save_contact():
            first_name = first_name_entry.get().strip()
            last_name = last_name_entry.get().strip()
            if not first_name and not last_name:
                messagebox.showwarning("Warning", "Enter at least first or last name!")
                return
            contact = {"phone": phone, "first_name": first_name, "last_name": last_name}
            self.phone_history.append(contact)
            self._save_data()
            self._update_displays()
            self._log(f"Saved: {first_name} {last_name} - {phone}", "success")
            dialog.destroy()
        
        ctk.CTkButton(dialog, text="Save Contact", command=save_contact, width=180, height=40, 
                     font=("Segoe UI", 13, "bold")).pack(pady=25)
    
    def _edit_contact(self):
        try:
            sel = self.phone_listbox.get("sel.first", "sel.last")
            index = int(sel.strip().split(".")[0]) - 1
            if index < 0 or index >= len(self.phone_history):
                return
            contact = self.phone_history[index]
            dialog = ctk.CTkToplevel(self)
            dialog.title("Edit Contact")
            dialog.geometry("420x370")
            dialog.resizable(False, False)
            dialog.grab_set()
            x = self.winfo_x() + (self.winfo_width() - 420) // 2
            y = self.winfo_y() + (self.winfo_height() - 370) // 2
            dialog.geometry(f"+{x}+{y}")
            
            ctk.CTkLabel(dialog, text="Phone Number:", font=("Segoe UI", 13, "bold")).pack(pady=(20, 5))
            ctk.CTkLabel(dialog, text=contact.get('phone', ''), font=("Inter", 11)).pack()
            ctk.CTkLabel(dialog, text="First Name:", font=("Segoe UI", 13, "bold")).pack(pady=(15, 5))
            first_name_entry = ctk.CTkEntry(dialog, width=280, font=("Inter", 11))
            first_name_entry.insert(0, contact.get('first_name', ''))
            first_name_entry.pack()
            ctk.CTkLabel(dialog, text="Last Name:", font=("Segoe UI", 13, "bold")).pack(pady=(10, 5))
            last_name_entry = ctk.CTkEntry(dialog, width=280, font=("Inter", 11))
            last_name_entry.insert(0, contact.get('last_name', ''))
            last_name_entry.pack()
            
            def save_edit():
                contact['first_name'] = first_name_entry.get().strip()
                contact['last_name'] = last_name_entry.get().strip()
                self._save_data()
                self._update_displays()
                self._log(f"Contact updated: {contact.get('first_name')} {contact.get('last_name')}", "success")
                dialog.destroy()
            
            ctk.CTkButton(dialog, text="Save Changes", command=save_edit, width=180, height=40, 
                        font=("Segoe UI", 13, "bold")).pack(pady=25)
        except:
            messagebox.showwarning("Error", "No contact selected!")
    
    def _delete_contact(self):
        try:
            sel = self.phone_listbox.get("sel.first", "sel.last")
            index = int(sel.strip().split(".")[0]) - 1
            if index < 0 or index >= len(self.phone_history):
                return
            contact = self.phone_history[index]
            name = f"{contact.get('first_name', '')} {contact.get('last_name', '')}".strip()
            phone = contact.get('phone', '')
            if messagebox.askyesno("Confirm Delete", f"Delete {name} - {phone}?"):
                self.phone_history.pop(index)
                self._save_data()
                self._update_displays()
                self._log(f"Deleted: {name} - {phone}", "warning")
        except:
            messagebox.showwarning("Error", "No contact selected!")
    
    def _use_selected_contact(self):
        try:
            sel = self.phone_listbox.get("sel.first", "sel.last")
            lines = sel.strip().split("\n")
            display_text = lines[0]
            if " - " in display_text:
                phone = display_text.split(" - ")[1]
            else:
                phone = display_text.split(". ")[1]
            self.phone_entry.delete(0, "end")
            self.phone_entry.insert(0, phone)
            self._validate_phone()
            self._log(f"Selected: {phone}", "info")
        except:
            messagebox.showwarning("Error", "No contact selected!")
    
    def _save_phone_simple(self):
        if not self._validate_phone():
            return
        phone = self.phone_entry.get().strip()
        for contact in self.phone_history:
            if contact.get('phone') == phone:
                messagebox.showwarning("Warning", "Phone number already exists!")
                return
        self._open_save_contact_dialog()
    
    def _paste_phone(self):
        try:
            phone = self.clipboard_get().strip()
            phone = re.sub(r'[^0-9]', '', phone)
            if len(phone) >= 10:
                self.phone_entry.delete(0, "end")
                self.phone_entry.insert(0, phone)
                self._log("Phone pasted from clipboard", "info")
                self._validate_phone()
            else:
                self._log("Invalid phone in clipboard", "warning")
        except:
            self._log("Clipboard access error", "error")
    
    # ==================== لیست سیاه ====================
    def _add_to_blacklist(self):
        phone = self.phone_entry.get().strip()
        if not self._validate_phone():
            return
        if phone not in self.blacklist:
            self.blacklist.append(phone)
            self._save_data()
            self._update_displays()
            self._log(f"Blacklisted: {phone}", "warning")
            if self.settings.get("sound", True):
                winsound.Beep(1000, 200)
    
    def _remove_from_blacklist(self):
        try:
            sel = self.black_listbox.get("sel.first", "sel.last")
            phone = sel.strip().split(". ")[1]
            if phone in self.blacklist:
                self.blacklist.remove(phone)
                self._save_data()
                self._update_displays()
                self._log(f"Removed from blacklist: {phone}", "success")
        except:
            messagebox.showwarning("Error", "No phone selected!")
    
