    def _start_attack(self):
        if self.is_running:
            return
        if not self._validate_phone():
            messagebox.showwarning("Error", "Invalid phone number")
            return
        phone = self.phone_entry.get().strip()
        if phone in self.blacklist:
            messagebox.showwarning("Error", "Phone is blacklisted")
            return
        
        attack_mode = self.method_combo.get()
        delay = self.settings.get("default_delay", 3)
        
        # حالت همزمان
        if attack_mode == "Full Attack (All 5 Sites)":
            counts = {
                "divar": self._get_count(self.divar_count_entry.get(), 3, 1, 5),
                "ketabrah": self._get_count(self.ketabrah_count_entry.get(), 2, 1, 3),
                "rubika": self._get_count(self.rubika_count_entry.get(), 2, 1, 3),
                "aparat": self._get_count(self.aparat_count_entry.get(), 2, 1, 3),
                "torob": self._get_count(self.torob_count_entry.get(), 2, 1, 3),
            }
            total = sum(counts.values())
            
            if not messagebox.askyesno("Confirm Attack", 
                                       f"🔥 Full Attack (5 Sites)\n\nTarget: {phone}\n"
                                       f"Divar: {counts['divar']}\n"
                                       f"Ketabrah: {counts['ketabrah']}\n"
                                       f"Rubika: {counts['rubika']}\n"
                                       f"Aparat: {counts['aparat']}\n"
                                       f"Torob: {counts['torob']}\n"
                                       f"\nTotal Messages: {total}\n\nProceed?"):
                return
            
            self.stats = {"success": 0, "failed": 0}
            self._update_stats_display()
            self.is_running = True
            self.start_btn.configure(state="disabled", text="⚔️ Full Attack...")
            self.stop_btn.configure(state="normal")
            self.status_label.configure(text="● Full Attack in progress", text_color="#FF9800")
            
            def run():
                sites = [
                    ("Divar", self._send_via_divar_api, counts["divar"]),
                    ("Ketabrah", self._send_via_ketabrah_selenium, counts["ketabrah"]),
                    ("Rubika", self._send_via_rubika_selenium, counts["rubika"]),
                    ("Aparat", self._send_via_aparat_selenium, counts["aparat"]),
                    ("Torob", self._send_via_torob_selenium, counts["torob"])
                ]
                total_success = 0
                total_attempts = sum(c for _, _, c in sites)
                
                for site_name, send_func, count in sites:
                    if not self.is_running:
                        break
                    for i in range(count):
                        if not self.is_running:
                            break
                        self._log(f"{site_name} → {i+1}/{count}", "info")
                        if send_func(phone):
                            total_success += 1
                            self._log(f"  ✓ {site_name} #{i+1} sent", "success")
                        else:
                            self._log(f"  ✗ {site_name} #{i+1} failed", "error")
                        
                        self.stats["success"] = total_success
                        self.stats["failed"] = total_attempts - total_success
                        self._update_stats_display()
                        time.sleep(delay)
                
                self.is_running = False
                self.start_btn.configure(state="normal", text="🚀 Start Attack")
                self.stop_btn.configure(state="disabled")
                self.status_label.configure(text="● Ready", text_color="#00C853")
                
                self._save_history({
                    "time": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                    "phone": phone,
                    "mode": "Full Attack (5 Sites)",
                    "success": total_success,
                    "total": total_attempts,
                    "result": "Completed" if total_success > 0 else "Failed"
                })
                self._update_dashboard()
                self._update_history_tab()
                self._log(f"Attack finished | Success: {total_success}/{total_attempts}", "success" if total_success>0 else "error")
                if self.settings.get("sound", True):
                    winsound.Beep(1500, 500)
                if self.settings.get("notifications", True):
                    Notification.show(self, f"Attack completed! Success: {total_success}/{total_attempts}", "success" if total_success>0 else "error")
            
            threading.Thread(target=run, daemon=True).start()
            return
        
        # حالت تکی
        send_map = {
            "Divar API (Fast)": (self._send_via_divar_api, "Divar", 5),
            "Ketabrah Selenium": (self._send_via_ketabrah_selenium, "Ketabrah", 3),
            "Rubika Selenium": (self._send_via_rubika_selenium, "Rubika", 3),
            "Aparat Selenium": (self._send_via_aparat_selenium, "Aparat", 3),
            "Torob Selenium": (self._send_via_torob_selenium, "Torob", 3),
        }
        
        if attack_mode not in send_map:
            return
        
        send_func, method_name, max_count = send_map[attack_mode]
        try:
            count = int(self.count_entry.get())
            count = max(1, min(max_count, count))
        except:
            count = 3 if max_count > 3 else max_count
        
        if not messagebox.askyesno("Confirm Attack", f"Mode: {method_name}\nTarget: {phone}\nCount: {count}\n\nProceed?"):
            return
        
        self.stats = {"success": 0, "failed": 0}
        self._update_stats_display()
        self.is_running = True
        self.start_btn.configure(state="disabled", text="📨 Sending...")
        self.stop_btn.configure(state="normal")
        self.status_label.configure(text="● Sending...", text_color="#FF9800")
        
        def run():
            success_count = 0
            for i in range(count):
                if not self.is_running:
                    break
                self._log(f"{method_name} → {i+1}/{count}", "info")
                if send_func(phone):
                    success_count += 1
                    self._log(f"  ✓ Message #{i+1} sent", "success")
                else:
                    self._log(f"  ✗ Message #{i+1} failed", "error")
                
                self.stats["success"] = success_count
                self.stats["failed"] = count - success_count
                self._update_stats_display()
                if self.is_running and i < count-1 and delay > 0:
                    time.sleep(delay)
            
            self._save_history({
                "time": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                "phone": phone,
                "mode": method_name,
                "success": success_count,
                "total": count,
                "result": "Completed" if success_count > 0 else "Failed"
            })
            self._log(f"Attack finished | Success: {success_count}/{count}", "success" if success_count>0 else "error")
            self.is_running = False
            self.start_btn.configure(state="normal", text="🚀 Start Attack")
            self.stop_btn.configure(state="disabled")
            self.status_label.configure(text="● Ready", text_color="#00C853")
            self._update_dashboard()
            self._update_history_tab()
            if self.settings.get("sound", True):
                winsound.Beep(1500, 500)
            if self.settings.get("notifications", True):
                Notification.show(self, f"Attack completed! Success: {success_count}/{count}", "success" if success_count>0 else "error")
        
        threading.Thread(target=run, daemon=True).start()
    
    def _stop_attack(self):
        self.is_running = False
        self._log("⚠️ Stopping attack...", "warning")
    
    def _get_count(self, value, default, min_val, max_val):
        try:
            c = int(value)
            return max(min_val, min(max_val, c))
        except:
            return default
    
